{
  "name": "mpile",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/wrangler-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/integration.mjs",
    "check:build": "node scripts/check-build.mjs",
    "deploy:prepare": "node scripts/prepare-selfhost.mjs",
    "creation-key": "node scripts/creation-key.mjs",
    "check:environment": "node ../scripts/check-environment.mjs",
    "check:ui": "malverdesoftware-ui-check .",
    "verify": "npm run check:environment && npm run check:ui && npm run lint && npm test && npm run typecheck && npm run build && npm run check:build && node ../scripts/build-manifest.mjs",
    "demo": "node scripts/demo-local.mjs",
    "console": "node scripts/console-local.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:console": "node tests/console-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@jetbrains/icons": "5.24.0",
    "@jetbrains/ring-ui-built": "7.0.133",
    "@malverdesoftware/relay": "0.1.1",
    "@malverdesoftware/sealed-envelope": "0.1.2",
    "@malverdesoftware/session-client": "0.1.4",
    "@malverdesoftware/ui": "0.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
